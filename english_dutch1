
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#123c35">
<meta name="description" content="Learn Dutch step by step with English translations, flashcards and quizzes.">
<title>Dutch Learning — English to Dutch</title>
<style>
:root {
  --green:#123c35;
  --mint:#dff4e9;
  --cream:#fbfaf5;
  --ink:#172923;
  --muted:#64756e;
  --line:#e4eae5;
}
* {box-sizing:border-box}
body {
  margin:0;background:var(--cream);color:var(--ink);
  font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif;
}
header {
  background:var(--green);color:white;
  padding:22px max(20px,calc((100% - 1050px)/2)) 28px;
}
.top {display:flex;justify-content:space-between;align-items:center;gap:12px}
.brand {font-weight:800;font-size:20px}
.tag {font-size:12px;background:#ffffff20;padding:6px 10px;border-radius:99px}
.hero {max-width:1050px;margin:26px auto 0}
.hero h1 {font-size:clamp(30px,5vw,48px);line-height:1.05;margin:0 0 12px}
.hero p {color:#d8e9e1;margin:0;max-width:560px}
main {max-width:1050px;margin:22px auto;padding:0 16px 50px}
.stats {display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}
.stat,.panel {background:white;border:1px solid var(--line);border-radius:18px;padding:16px}
.stat b {display:block;font-size:24px}
.stat span,.muted {color:var(--muted);font-size:13px}
nav {display:flex;gap:8px;overflow:auto;margin:18px 0;padding-bottom:4px}
nav button,.btn {
  border:0;border-radius:12px;padding:11px 15px;
  background:#edf2ee;color:var(--green);font-weight:700;
  cursor:pointer;white-space:nowrap
}
nav button.active,.btn.primary {background:var(--green);color:white}
.panel {padding:20px}
.view {display:none}
.view.active {display:block}
.row {display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.between {justify-content:space-between}
h2 {margin:0 0 8px;font-size:23px}
input,select {
  padding:12px 14px;border:1px solid var(--line);
  border-radius:12px;background:white;font:inherit;min-width:0
}
input {flex:1;min-width:180px}
.flash {
  max-width:560px;margin:18px auto;text-align:center;padding:30px 20px;
  background:linear-gradient(145deg,#f0faf4,#fff);
  border:1px solid #dcece1;border-radius:22px
}
.flash .word {font-size:clamp(30px,7vw,46px);font-weight:800;margin:12px}
.flash .translation {font-size:25px;color:#28745a;min-height:38px}
.flash small {color:var(--muted)}
.answers {display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:18px 0}
.answer {
  padding:15px;border:1px solid var(--line);border-radius:12px;
  background:white;text-align:left;font:inherit;cursor:pointer
}
.answer:disabled {opacity:.7}
.good {background:#e3f7e9!important;border-color:#62b77a!important}
.bad {background:#fff0ed!important;border-color:#e58a7a!important}
.list {display:grid;gap:8px;margin-top:14px}
.item {
  display:flex;justify-content:space-between;gap:12px;
  padding:12px;border-bottom:1px solid var(--line)
}
.item b {display:block}
.pill {font-size:12px;background:var(--mint);padding:4px 8px;border-radius:99px;color:var(--green)}
.progress {height:9px;background:#edf2ee;border-radius:99px;overflow:hidden;margin:10px 0}
.progress i {display:block;height:100%;background:#42a879;width:0}
footer {text-align:center;color:var(--muted);font-size:12px;padding:25px}
@media(max-width:600px) {
  .stats {gap:7px}
  .stat {padding:12px}
  .stat b {font-size:20px}
  .answers {grid-template-columns:1fr}
  .panel {padding:15px}
}
</style>
</head>
<body>

<header>
  <div class="top">
    <div class="brand">🇳🇱 Dutch Learning</div>
    <div class="tag">ENGLISH → DUTCH</div>
  </div>
  <div class="hero">
    <h1>Small steps.<br>Real Dutch progress.</h1>
    <p>Learn useful Dutch words, practise every day and build confidence one lesson at a time.</p>
  </div>
</header>

<main>
<section class="stats">
  <div class="stat"><b id="known">0</b><span>Words learned</span></div>
  <div class="stat"><b id="points">0</b><span>Points earned</span></div>
  <div class="stat"><b id="streak">0 🔥</b><span>Day streak</span></div>
</section>

<nav>
  <button class="active" data-tab="learn">Learn</button>
  <button data-tab="quiz">Quiz</button>
  <button data-tab="dictionary">Dictionary</button>
  <button data-tab="progress">My progress</button>
</nav>

<section id="learn" class="view active panel">
  <div class="row between">
    <div>
      <h2>Flashcards</h2>
      <div class="muted">See the English word, remember the Dutch translation.</div>
    </div>
    <select id="category"><option value="All">All topics</option></select>
  </div>
  <div class="flash">
    <small id="counter">Card 1</small>
    <div class="word" id="english">hello</div>
    <div class="translation" id="dutch">Tap “Show translation”</div>
    <small id="categoryLabel">Basics · A1</small>
  </div>
  <div class="row" style="justify-content:center">
    <button class="btn" id="speak">🔊 Hear Dutch</button>
    <button class="btn" id="reveal">Show translation</button>
    <button class="btn primary" id="learned">I knew it ✓</button>
    <button class="btn" id="next">Next →</button>
  </div>
</section>

<section id="quiz" class="view panel">
  <h2>Quick quiz</h2>
  <p class="muted">Choose the correct Dutch translation.</p>
  <div class="flash">
    <small>Translate into Dutch</small>
    <div class="word" id="qword">house</div>
    <div id="feedback" class="muted">Choose one answer below.</div>
  </div>
  <div class="answers" id="answers"></div>
  <button class="btn primary" id="nextQuiz">Next question →</button>
</section>

<section id="dictionary" class="view panel">
  <h2>Word dictionary</h2>
  <p class="muted">Search in English or Dutch.</p>
  <div class="row">
    <input id="search" placeholder="Search a word…">
    <select id="dictCategory"><option value="All">All topics</option></select>
  </div>
  <div id="results" class="list"></div>
</section>

<section id="progress" class="view panel">
  <h2>Your learning journey</h2>
  <p class="muted">Your progress is saved on this device.</p>
  <div class="row between">
    <b>Words learned</b><b id="progressText">0 / 100</b>
  </div>
  <div class="progress"><i id="bar"></i></div>
  <p id="encouragement">Start with your first flashcard today.</p>
  <button class="btn" id="reset">Reset my progress</button>
</section>
</main>

<footer>Dutch Learning · A friendly way to practise Dutch</footer>

<script>
let words = [];
let index = 0;
let known = new Set(JSON.parse(localStorage.getItem('dl_known') || '[]'));
let points = +(localStorage.getItem('dl_points') || 0);

const $ = id => document.getElementById(id);

async function init() {
  try {
    const r = await fetch('./words.json');
    if (!r.ok) throw new Error('Dictionary not found');
    words = await r.json();
  } catch(e) {
    $('english').textContent = 'Could not load words.json';
    return;
  }

  const cats = [...new Set(words.map(w => w.category))].sort();
  cats.forEach(c => {
    ['category','dictCategory'].forEach(id => {
      let o = document.createElement('option');
      o.value = c;
      o.textContent = c;
      $(id).append(o);
    });
  });

  updateStats();
  showCard();
  renderDictionary();
  newQuiz();
}

function filtered() {
  let c = $('category').value;
  return words.filter(w => c === 'All' || w.category === c);
}

function showCard() {
  let arr = filtered();
  if (!arr.length) return;
  index = index % arr.length;
  let w = arr[index];
  $('english').textContent = w.en;
  $('dutch').textContent = 'Tap “Show translation”';
  $('counter').textContent = `Card ${index+1} of ${arr.length}`;
  $('categoryLabel').textContent = `${w.category} · ${w.level}`;
}

$('reveal').onclick = () => {
  $('dutch').textContent = filtered()[index].nl;
};

$('next').onclick = () => {
  index++;
  showCard();
};

$('category').onchange = () => {
  index = 0;
  showCard();
};

$('learned').onclick = () => {
  let w = filtered()[index];
  known.add(w.en);
  points += 5;
  save();
  updateStats();
  index++;
  showCard();
};

$('speak').onclick = () => {
  let w = filtered()[index];
  let u = new SpeechSynthesisUtterance(w.nl);
  u.lang = 'nl-NL';
  speechSynthesis.speak(u);
};

function save() {
  localStorage.setItem('dl_known', JSON.stringify([...known]));
  localStorage.setItem('dl_points', points);
}

function updateStats() {
  $('known').textContent = known.size;
  $('points').textContent = points;
  $('progressText').textContent = `${known.size} / ${words.length}`;
  $('bar').style.width = Math.min(100, known.size / words.length * 100) + '%';
  $('encouragement').textContent = known.size
    ? `Great work! You have learned ${known.size} words. Keep going!`
    : 'Start with your first flashcard today.';
  $('streak').textContent = '0 🔥';
}

function newQuiz() {
  if (!words.length) return;
  let w = words[Math.floor(Math.random() * words.length)];
  $('qword').textContent = w.en;
  $('feedback').textContent = 'Choose one answer below.';
  let opts = [w];

  while (opts.length < 4) {
    let x = words[Math.floor(Math.random() * words.length)];
    if (!opts.includes(x)) opts.push(x);
  }

  opts.sort(() => Math.random() - .5);
  $('answers').innerHTML = '';

  opts.forEach(x => {
    let b = document.createElement('button');
    b.className = 'answer';
    b.textContent = x.nl;

    b.onclick = () => {
      [...$('answers').children].forEach(z => z.disabled = true);
      if (x === w) {
        b.classList.add('good');
        $('feedback').textContent = 'Correct! +10 points 🎉';
        points += 10;
        save();
        updateStats();
      } else {
        b.classList.add('bad');
        $('feedback').textContent = 'Correct answer: ' + w.nl;
        [...$('answers').children]
          .find(z => z.textContent === w.nl)?.classList.add('good');
      }
    };

    $('answers').append(b);
  });
}

$('nextQuiz').onclick = newQuiz;

function renderDictionary() {
  let q = $('search').value.toLowerCase();
  let c = $('dictCategory').value;

  let arr = words.filter(w =>
    (c === 'All' || w.category === c) &&
    (!q || w.en.toLowerCase().includes(q) || w.nl.toLowerCase().includes(q))
  ).slice(0,150);

  $('results').innerHTML = '';

  arr.forEach(w => {
    let d = document.createElement('div');
    d.className = 'item';
    d.innerHTML = '<div><b></b><span class="muted"></span></div><span class="pill"></span>';
    d.querySelector('b').textContent = w.en;
    d.querySelector('.muted').textContent = w.nl;
    d.querySelector('.pill').textContent = w.category;
    $('results').append(d);
  });

  if (!arr.length) $('results').textContent = 'No matching words found.';
}

$('search').oninput = renderDictionary;
$('dictCategory').onchange = renderDictionary;

document.querySelectorAll('nav button').forEach(b => {
  b.onclick = () => {
    document.querySelectorAll('nav button').forEach(x =>
      x.classList.toggle('active', x === b)
    );
    document.querySelectorAll('.view').forEach(x =>
      x.classList.toggle('active', x.id === b.dataset.tab)
    );
    if (b.dataset.tab === 'dictionary') renderDictionary();
  };
});

$('reset').onclick = () => {
  if (confirm('Reset all progress on this device?')) {
    known.clear();
    points = 0;
    save();
    updateStats();
  }
};

init();
</script>
</body>
</html>
